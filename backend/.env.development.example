# Copiar a .env.development (gitignored) y completar con valores del entorno de PRUEBAS.
# Uso: npm run dev:safe
NODE_ENV=development
ODOO_WRITES=dry
DISABLE_CRONS=true
# Obliga a dotenv a leer este archivo y nunca el .env de producción.
DOTENV_CONFIG_PATH=.env.development

# Proyecto Firebase de PRUEBAS (Firestore + Storage)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Odoo y Tienda Nube reales, solo lectura
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_PASSWORD=
TN_STORE_ID=
TN_ACCESS_TOKEN=
TN_USER_AGENT=

# Distinto del de producción
POS_AUTH_SECRET=
POS_SUPERADMIN_USERNAME=
POS_SUPERADMIN_INITIAL_PASSWORD=
POS_SUPERADMIN_NAME=
POS_BOT_SECRET=

# POS_INVOICING_ENABLED: dejar sin definir
